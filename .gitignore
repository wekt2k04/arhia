# ── Secrets / config locale ──
.env
.env*.local
appsettings.*.json
!appsettings.json.example
launchSettings.json
!launchSettings.json.example

# ── Build artifacts (.NET / Node, si réintroduits plus tard) ──
bin/
obj/
*.user
*.suo
.vs/
node_modules/
.next/
*.tsbuildinfo

# ── Tests / logs ──
TestResults/
coverage/
coverage.*
logs/
/*.log

# ── Modèles IA (poids ONNX, plusieurs centaines de Mo — jamais commités) ──
rag/models/
qdrant_storage/

# ── Presentation generee (binaire, non diffable — regenerable via generate_pptx.py) ──
docs/presentations/*.pptx

# ── Diagrammes LinkedIn animes (binaires, regenerables via docs/presentations/linkedin/diagram_*.py) ──
docs/presentations/linkedin/*.mp4
docs/presentations/linkedin/__pycache__/

# ── Docs internes / personnelles (pas destinees a une presentation publique du depot) ──
docs/APPRENTISSAGE/
docs/notebooklm/
docs/VERIFICATION_MIGRATION_ANGLAIS.md
docs/donnees_test/
docs/presentations/script_orateur.md

# ── HANDOFF interne (continuite entre sessions Claude Code, pas pour le grand public) ──
.claude/HANDOFF/

# ── Overrides locaux (jamais partages) ──
.claude/settings.local.json
