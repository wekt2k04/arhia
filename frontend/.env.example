# ─────────────────────────────────────────────────────────────────────────────
# AGIRH — Frontend Next.js (variables d'environnement)
# ─────────────────────────────────────────────────────────────────────────────
# URL de l'API backend .NET AGIRH. Utilisée UNIQUEMENT côté serveur par les
# route handlers BFF (src/app/api/auth/* et src/app/api/agent/*).
#
# NE PAS préfixer par NEXT_PUBLIC_ : cette valeur ne doit jamais atteindre le
# bundle client (elle resterait sinon visible dans les sources chargées).
AGIRH_API_URL=http://localhost:5000
