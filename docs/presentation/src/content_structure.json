          "title": "Le dispatcher C# tranche avant tout appel au LLM",
          "left": "La sentinelle DENIED devient la bulle orange côté frontend. Un rejet métier reste une réponse polie.",
          "code": {
            "language": "csharp",
            "file": "AgentOrchestratorService.cs",
            "lines": [
              {
                "t": "var intent = await _profiler.ExtractAsync(message);"
              },
              {
                "t": "var preflight = _validator.Validate(intent);",
                "muted": true
              },
              {
                "t": "if (!preflight.IsValid) return Reply(preflight.Message);",
                "muted": true
              },
              {
                "t": "var dispatch = _dispatcher.Dispatch(intent, role, userId);"
              },
              {
                "t": "if (dispatch.Rejected) return Sentinel(DENIED);"
              },
              {
                "t": "var worker = await _worker.RunAsync(dispatch.Tool);",
                "muted": true
              },
              {
                "t": "var draft = await _synthesizer.ReformulateAsync(worker);",
                "muted": true
              },
              {
                "t": "return await _checker.ValidateAsync(draft);"
              }
            ]
          },
          "notes": "3 lignes vitales surlignées : Dispatch, DENIED, Checker. Le reste grisé.",
          "anim": "sequence"
        },
